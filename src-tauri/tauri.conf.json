{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-conf-schema/refs/heads/main/schema.json",
  "productName": "IconForge",
  "version": "2.3.0",
  "identifier": "com.iconforge.app",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IconForge",
        "width": 1240,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "center": true,
        "backgroundColor": "#1e1e20"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../realcugan-ncnn-vulkan-20220728-windows/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
