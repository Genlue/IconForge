{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri-conf-schema/refs/heads/main/schema.json",
  "productName": "IconForge",
  "version": "1.0.0",
  "identifier": "com.iconforge.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "IconForge",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 700,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
